# Copie para .env.local e preencha. Todas são do SERVIDOR: nenhuma tem prefixo NEXT_PUBLIC_.
#
# Sem nenhuma preenchida, o site roda em MODO DEMONSTRAÇÃO: dados em memória com 12 respostas
# fictícias, e a senha dos noivos é "demo" (avisada na tela de login só nesse modo).
# Na produção da Vercel, a falta do banco é erro — a não ser com DEMO=true.

# Connection string do Postgres. Na Vercel, o Marketplace (Neon) preenche sozinho.
DATABASE_URL=

# Senha única dos noivos para /convidados (mínimo 8 caracteres).
SENHA_NOIVOS=

# Segredo que assina o cookie de sessão dos noivos (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SECRET=

# Sal do hash do telefone (mínimo 16 caracteres aleatórios). Nunca troque depois de publicar:
# as respostas antigas deixariam de ser reconhecidas no "você já confirmou".
RSVP_SALT=

# "true" liga o modo demonstração mesmo com DATABASE_URL (preview para o casal).
DEMO=
