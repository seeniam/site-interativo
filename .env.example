# Copie para .env.local e preencha.
# Sem as chaves do Firebase: em desenvolvimento, o site roda na demonstração local (respostas
# guardadas no navegador). Em produção, o build recusa rodar sem elas — a não ser com
# NEXT_PUBLIC_MODO_DEMONSTRACAO=1, para um preview do casal. Chaves pela metade sempre dão erro.
#
# São chaves PÚBLICAS do Firebase (Console → Configurações do projeto → Seus apps → Web).
# A proteção dos dados está em firestore.rules. Nunca coloque aqui a chave de serviço (admin).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "1" libera a demonstração local num build de produção (preview). Nunca no site publicado.
NEXT_PUBLIC_MODO_DEMONSTRACAO=

# PIN do botão "Mostrar telefones" em /convidados. É dissuasão, não segurança (DECISOES).
NEXT_PUBLIC_PIN_NOIVOS=
